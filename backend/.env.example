# ===== Database local (chạy bằng docker compose up -d db) =====
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/tmdt

# JWT local — chuỗi bí mật bất kỳ, đủ dài. Backend tự cấp/verify token.
SECRET_KEY=doi_thanh_chuoi_bi_mat_du_dai

VIETQR_CLIENT_ID=
VIETQR_API_KEY=
BANK_BIN=970436
ACCOUNT_NO=
ACCOUNT_NAME=

# SePay webhook (đối soát QR tự động): chọn API Key hoặc HMAC secret.
SEPAY_API_KEY=
SEPAY_WEBHOOK_SECRET=

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# ===== Production (Render / VPS) =====
# URL frontend thật — dùng làm CORS mặc định và cho VNPay redirect.
FRONTEND_URL=http://localhost:5173

# Danh sách origin được CORS chấp nhận, ngăn cách dấu phẩy (rỗng = fallback [frontend_url, localhost]).
# Ví dụ: https://tmdt-frontend.onrender.com,https://tmdt-admin.onrender.com
CORS_ORIGINS=

# Thư mục lưu file upload; trên Render trỏ vào Disk mount để không mất khi redeploy.
# Ví dụ: UPLOADS_DIR=/var/data/uploads
UPLOADS_DIR=uploads

# URL mà VNPay return về sau khi thanh toán (phải chạy qua HTTPS ở production).
# Ví dụ: VNPAY_RETURN_URL=https://tmdt-backend.onrender.com/api/v1/payments/vnpay/return
VNPAY_RETURN_URL=http://localhost:8001/api/v1/payments/vnpay/return
