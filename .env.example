# Copy file này thành .env rồi điền giá trị (docker compose tự đọc .env)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password
POSTGRES_DB=tmdt
# Password đã URL-encode (@ -> %40, # -> %23, v.v.). VD: a@b# -> a%40b%23
POSTGRES_PASSWORD_URL=your_encoded_password

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password